{
  "nome": "rclr-website",
  "versao": 1,
  "protegidos": [
    "ci/**",
    "package.json",
    "package-lock.json"
  ],
  "jobs": [
    {
      "id": "build",
      "run": "npm ci && npm run build",
      "paths": [
        "content/**",
        "index.html",
        "package-lock.json",
        "package.json",
        "postcss.config.js",
        "public/**",
        "scripts/**",
        "src/**",
        "tailwind.config.js",
        "vite.config.js",
        "wrangler.jsonc"
      ],
      "classe": "pre-merge",
      "timeout_seg": 600,
      "sandbox": {
        "rede": "liberada",
        "memoria_max_mb": -1,
        "processos_max": 1024,
        "descritores_max": 4096
      }
    }
  ]
}
