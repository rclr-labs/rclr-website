{
  "nome": "rclr-website",
  "versao": 1,
  "protegidos": ["ci/**", "package.json", "package-lock.json"],
  "jobs": [
    {
      "id": "lint",
      "run": "npm ci && npm run lint",
      "paths": ["src/**", "scripts/**", "eslint.config.js", "package.json", "package-lock.json"],
      "classe": "pre-merge",
      "timeout_seg": 300,
      "sandbox": { "rede": "liberada" }
    },
    {
      "id": "build",
      "run": "npm ci && npm run build",
      "needs": ["lint"],
      "paths": ["src/**", "scripts/**", "content/**", "package.json", "package-lock.json", "vite.config.js"],
      "classe": "pre-merge",
      "timeout_seg": 600,
      "sandbox": { "rede": "liberada" }
    }
  ]
}
